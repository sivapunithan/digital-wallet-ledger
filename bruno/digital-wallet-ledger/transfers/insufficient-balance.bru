meta {
  name: Insufficient Balance (should 400)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/transfers
  body: json
  auth: none
}

body:json {
  {
    "fromAccountId": "{{aliceId}}",
    "toAccountId": "{{bobId}}",
    "amount": 999999999.00,
    "idempotencyKey": "{{$randomUUID}}"
  }
}

assert {
  res.status: eq 400
}